  dialogueText: {fileID: 1428148275}
  choicesParent: {fileID: 1840996888}
  choiceButtonPrefab: {fileID: 6391532048955935353, guid: 863e83be45620a04e8b1f46392b0c811, type: 3}
  startNode: 0
  nodes:
  - text: "Ah, FINALMENTE, finalmente voc\xEA chegou."
    autoNextNode: 1
    choices: []
  - text: "Voc\xEA tem [anim=Angry]NO\xC7\xC3O[/anim] do preju\xEDso que voc\xEA
      criou para essa empresa?"
    autoNextNode: 2
    choices: []
  - text: "Voc\xEA sabe quantos [anim=Shake]universos[/anim] tive que destruir por
      sua causa?"
    autoNextNode: 3
    choices: []
  - text: "Como \xE9 poss\xEDvel um ser inferior de apenas 3 dimens\xF5es causar
      tantos problemas?? [anim=Angry]ME FALA[/anim]"
    autoNextNode: 4
    choices: []
  - text: ...
    autoNextNode: 5
    choices: []
  - text: "[anim=Angry]VOC\xCA TA ME OUVINDO???[/anim]"
    autoNextNode: 6
    choices: []
  - text: . . .
    autoNextNode: 7
    choices: []
  - text: "Vamos fazer o seguinte: pelo carinho que tenho por voc\xEA vou te dar
      uma chance!"
    autoNextNode: 8
    choices: []
  - text: "continue seu trabalho, se algo der errado, eu vou apagar [anim=Angry]voc\xEA
      e seu universo! [/anim]"
    autoNextNode: 9
    choices: []
  - text: pegue a sua espada e saia.
    autoNextNode: -1
    choices: []
